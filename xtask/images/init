#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
/sbin/net-setup-guard
/sbin/report-readiness
dylos-agent &
if grep -q "dylos.writer=1" /proc/cmdline; then
    (
        while :; do
            dd if=/dev/urandom of=/var/log/churn.dat bs=4k count=1 conv=notrunc oflag=append 2>/dev/null
            sync
        done
    ) &
fi
# PID 1 must survive console logout; Alpine BusyBox provides setsid -c, not cttyhack.
while :; do
    setsid -c /bin/sh -i </dev/ttyS0 >/dev/ttyS0 2>&1
    # Back off even when the console fails to open or immediately hangs up.
    sleep 1
done
