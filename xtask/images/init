#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
/sbin/net-setup-guard
/sbin/report-readiness
dylos-agent &
if grep -q "write_churn=1" /proc/cmdline; then
    # Fixed-size overwrite churn workload
    (
        seek=0
        while :; do
            dd if=/dev/urandom of=/var/log/churn.dat bs=4k count=1 seek="$seek" conv=notrunc 2>/dev/null
            seek=$(( (seek + 1) % 1024 ))
            sync
        done
    ) &
    # Complementary allocation-heavy workload (create, append, rename, delete files in a loop)
    (
        mkdir -p /var/log/alloc_churn
        i=0
        while :; do
            slot=$(( i % 16 ))
            # Delete older file in this slot (frees inode and blocks)
            rm -f "/var/log/alloc_churn/file_${slot}.dat"
            # Create new file (allocates inode and blocks)
            dd if=/dev/urandom of="/var/log/alloc_churn/file_${slot}.tmp" bs=4k count=$(( (i % 8) + 1 )) 2>/dev/null
            # Append more blocks (exercises extent growth and dynamic block allocation)
            dd if=/dev/urandom of="/var/log/alloc_churn/file_${slot}.tmp" bs=4k count=2 conv=notrunc oflag=append 2>/dev/null
            # Rename (exercises directory entry modification and dir_index)
            mv "/var/log/alloc_churn/file_${slot}.tmp" "/var/log/alloc_churn/file_${slot}.dat"
            sync
            i=$(( i + 1 ))
        done
    ) &
fi
# PID 1 must survive console logout; Alpine BusyBox provides setsid -c, not cttyhack.
while :; do
    setsid -c /bin/sh -i </dev/ttyS0 >/dev/ttyS0 2>&1
    # Back off even when the console fails to open or immediately hangs up.
    sleep 1
done
